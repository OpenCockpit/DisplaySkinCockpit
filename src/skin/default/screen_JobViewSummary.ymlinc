screen:
  name: "JobViewSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_big"
        halign: "left"
        position: "0,0"
        render: "Label"
        size: "$screen_width-4,65"
        source: "parent.summary_job_name"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "$F_medium"
        halign: "left"
        position: "0,65"
        render: "Label"
        size: "$screen_width-4,65"
        source: "parent.summary_job_task"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - widget:
        borderColor: "FdLcdAmber"
        borderWidth: "2"
        position: "0,130"
        render: "Progress"
        size: "$screen_width-4,65"
        source: "parent.summary_job_progress"
        transparent: "1"
        zPosition: "3"
    - widget:
        font: "$F_small"
        foregroundColor: "white"
        halign: "center"
        position: "0,130"
        render: "Label"
        size: "$screen_width-4,65"
        source: "parent.summary_job_progress"
        transparent: "1"
        valign: "center"
        zPosition: "4"
        children:
          - convert:
              type: "ProgressToText"
