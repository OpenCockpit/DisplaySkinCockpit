screen:
  name: "SetupSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_big"
        halign: "center"
        noWrap: "1"
        position: "0,0"
        render: "Label"
        size: "$screen_width-4,65"
        source: "SetupTitle"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "$F_medium"
        halign: "center"
        noWrap: "1"
        position: "0,65"
        render: "Label"
        size: "$screen_width-4,55"
        source: "SetupEntry"
        transparent: "1"
        zPosition: "2"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,120"
        render: "Label"
        size: "$screen_width-4,115"
        source: "SetupValue"
        transparent: "1"
        valign: "center"
        zPosition: "2"
