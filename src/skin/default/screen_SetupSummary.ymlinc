screen:
  name: "SetupSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_big"
        halign: "center"
        noWrap: "1"
        position: "0,0"
        render: "Label"
        size: "$width,65"
        source: "SetupTitle"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "$F_medium"
        halign: "center"
        noWrap: "1"
        position: "0,65"
        render: "Label"
        size: "$width,55"
        source: "SetupEntry"
        zPosition: "2"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,120"
        render: "Label"
        size: "$width,115"
        source: "SetupValue"
        valign: "center"
        zPosition: "2"
