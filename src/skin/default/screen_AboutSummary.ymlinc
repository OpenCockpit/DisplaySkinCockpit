screen:
  name: "AboutSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$screen_width-4,$screen_height-25"
        source: "AboutText"
        transparent: "1"
        valign: "center"
        zPosition: "2"
