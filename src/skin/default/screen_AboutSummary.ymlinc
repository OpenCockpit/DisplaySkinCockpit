screen:
  name: "AboutSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$width,$height-25"
        source: "AboutText"
        valign: "center"
        zPosition: "2"
