screen:
  name: "MovieSelectionSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$width,$height-70"
        source: "name"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "$F_bigger"
        halign: "left"
        position: "0,$height-70"
        render: "Label"
        size: "300,70"
        source: "parent.Service"
        valign: "center"
        children:
          - convert:
              type: "COCMovieInfo"
              text: "FileSize"
    - widget:
        font: "$F_bigger"
        halign: "right"
        position: "300,$height-70"
        render: "Label"
        size: "92,70"
        source: "parent.Service"
        valign: "center"
        children:
          - convert:
              type: "COCMovieInfo"
              text: "MovieDuration"
          - convert:
              type: "ClockToText"
              text: "InMinutes"
