screen:
  name: "MovieSelectionSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$screen_width-4,$screen_height-70"
        source: "name"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "$F_bigger"
        halign: "left"
        position: "0,$screen_height-70"
        render: "Label"
        size: "300,70"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCMovieInfo"
              text: "FileSize"
    - widget:
        font: "$F_bigger"
        halign: "right"
        position: "300,$screen_height-70"
        render: "Label"
        size: "92,70"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCMovieInfo"
              text: "MovieDuration"
          - convert:
              type: "ClockToText"
              text: "InMinutes"
