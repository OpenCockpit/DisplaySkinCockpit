- widget:
    font: "$F_bigger"
    halign: "left"
    position: "0,$screen_height-70"
    render: "Label"
    size: "200,70"
    source: "parent.ServiceEvent"
    transparent: "1"
    valign: "center"
    children:
      - convert:
          type: "EventTime"
          text: "StartTime"
      - convert:
          type: "ClockToText"
          text: "Format:%H:%M"
- widget:
    font: "$F_bigger"
    halign: "right"
    position: "200,$screen_height-70"
    render: "Label"
    size: "$screen_width-4-200,70"
    source: "parent.ServiceEvent"
    transparent: "1"
    valign: "center"
    children:
      - convert:
          type: "EventTime"
          text: "Remaining"
      - convert:
          type: "RemainingToText"
          text: "VFDOnlyMinutes"
