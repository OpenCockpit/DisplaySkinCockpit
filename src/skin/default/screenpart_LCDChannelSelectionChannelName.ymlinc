- widget:
    font: "$F_big"
    halign: "center"
    options: "movetype=running,startpoint=0,direction=left,steptime=80,repeat=3,always=0,oneshot=1,startdelay=6000,wrap"
    position: "0,0"
    render: "RunningText"
    size: "$screen_width-4,130"
    source: "parent.ServiceEvent"
    transparent: "1"
    valign: "center"
    zPosition: "2"
    children:
      - convert:
          type: "ServiceName"
          text: "Name"
