- widget:
    font: "$F_big"
    halign: "center"
    position: "0,0"
    render: "Label"
    size: "$width,65"
    source: "text"
    valign: "center"
- widget:
    font: "$F_medium"
    halign: "center"
    position: "0,65"
    render: "Label"
    size: "$width,175"
    source: "parent.list"
    children:
      - convert:
          type: "StringListSelection"
