screen:
  name: "ChannelSelectionRadioSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$width,$height"
        source: "parent.RdsDecoder"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "RdsInfo"
              text: "RtpText"
