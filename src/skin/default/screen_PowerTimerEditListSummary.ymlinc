screen:
  name: "PowerTimerEditListSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - xmlinc:
        file: "screenpart_LCDTitle.ymlinc"
    - widget:
        font: "$F_small"
        halign: "center"
        noWrap: "1"
        position: "0,65"
        render: "Label"
        size: "$screen_width-4,40"
        source: "timertype"
        transparent: "1"
        valign: "center"
    - widget:
        font: "$F_small"
        halign: "center"
        position: "0,105"
        render: "Label"
        size: "$screen_width-4,40"
        source: "time"
        transparent: "1"
        valign: "center"
    - widget:
        font: "$F_small"
        halign: "center"
        position: "0,145"
        render: "Label"
        size: "$screen_width-4,40"
        source: "duration"
        transparent: "1"
        valign: "center"
    - widget:
        font: "$F_small"
        halign: "center"
        position: "0,185"
        render: "Label"
        size: "$screen_width-4,40"
        source: "state"
        transparent: "1"
        valign: "center"
