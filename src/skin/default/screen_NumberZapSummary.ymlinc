screen:
  name: "NumberZapSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_big"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$width,65"
        source: "parent.servicename_summary"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "$F_huge"
        halign: "center"
        position: "0,65"
        render: "Label"
        size: "$width,$height-65"
        source: "parent.number_summary"
        valign: "center"
        zPosition: "2"
