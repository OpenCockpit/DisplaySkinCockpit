screen:
  name: "AutoTimerOverviewSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - xmlinc:
        file: "screenpart_LCDTitle.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,65"
        render: "Label"
        size: "$screen_width-4,$screen_height-65"
        source: "entry"
        transparent: "1"
        zPosition: "1"
