screen:
  name: "NetworkServicesSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - xmlinc:
        file: "screenpart_LCDTitle.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,65"
        render: "Label"
        size: "$width,115"
        source: "status_summary"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$F_small"
        halign: "center"
        position: "0,180"
        render: "Label"
        size: "$width,60"
        source: "autostartstatus_summary"
        valign: "center"
