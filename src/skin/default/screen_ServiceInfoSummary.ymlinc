screen:
  name: "ServiceInfoSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_medium"
        noWrap: "1"
        position: "0,0"
        render: "Label"
        size: "$screen_width-4,$screen_height-25"
        source: "info"
        transparent: "1"
