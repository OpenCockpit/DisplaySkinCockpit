screen:
  name: "InfoBarMoviePlayerSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_big"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$screen_width-4,130"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceName"
              text: "Name"
    - xmlinc:
        file: "screenpart_LCDInfoBarMovieProgress.ymlinc"
    - widget:
        font: "$F_bigger"
        halign: "left"
        position: "0,$screen_height-70"
        render: "Label"
        size: "230,70"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "EndTime,ShowNoSeconds"
    - widget:
        font: "$F_bigger"
        halign: "right"
        position: "230,$screen_height-70"
        render: "Label"
        size: "$screen_width-4-230,70"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Remaining,ShowNoSeconds"
