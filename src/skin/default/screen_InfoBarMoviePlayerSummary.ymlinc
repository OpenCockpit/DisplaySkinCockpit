screen:
  name: "InfoBarMoviePlayerSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_big"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$width,130"
        source: "session.CurrentService"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceName"
              text: "Name"
    - xmlinc:
        file: "screenpart_LCDInfoBarMovieProgress.ymlinc"
    - xmlinc:
        file: "screenpart_LCDInfoBarMovieEndRemaining.ymlinc"
