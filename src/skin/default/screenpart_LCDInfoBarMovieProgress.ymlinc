- widget:
    borderColor: "FdLcdAmber"
    borderWidth: "2"
    position: "0,140"
    render: "Progress"
    size: "$screen_width-4,20"
    source: "session.CurrentService"
    transparent: "1"
    zPosition: "2"
    children:
      - convert:
          type: "ServicePosition"
          text: "VFDPosition"
