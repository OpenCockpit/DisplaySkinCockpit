screen:
  name: "UpdatePluginSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - xmlinc:
        file: "screenpart_LCDTitle.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,65"
        render: "Label"
        size: "$width,115"
        source: "parent.package"
    - widget:
        font: "$F_small"
        halign: "center"
        position: "0,180"
        render: "Label"
        size: "$width,60"
        source: "parent.status"
        valign: "center"
