screen:
  name: "StandbySummary"
  children:
    - widget:
        font: "$F_giant"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$width,$height"
        source: "global.CurrentTime"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "ClockToText"
              text: "Default"
