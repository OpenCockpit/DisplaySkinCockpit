screen:
  name: "StandbySummary"
  position: "fill"
  resolution: "396,240"
  children:
    - widget:
        font: "$F_giant"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$screen_width-4,$screen_height"
        source: "global.CurrentTime"
        transparent: "1"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "ClockToText"
              text: "Default"
