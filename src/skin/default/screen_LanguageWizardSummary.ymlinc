screen:
  name: "LanguageWizardSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "$F_big"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$width,65"
        source: "parent.summarytext"
        valign: "center"
        zPosition: "2"
