screen:
  name: "MenuSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - xmlinc:
        file: "screenpart_LCDTitle.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,65"
        render: "Label"
        size: "$width,175"
        source: "parent.menu"
        zPosition: "2"
        children:
          - convert:
              type: "StringListSelection"
