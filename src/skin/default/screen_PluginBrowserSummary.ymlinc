screen:
  name: "PluginBrowserSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - xmlinc:
        file: "screenpart_LCDTitle.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        noWrap: "1"
        position: "0,65"
        render: "Label"
        size: "$screen_width-4,65"
        source: "entry"
        transparent: "1"
        zPosition: "2"
    - widget:
        font: "$F_small"
        halign: "center"
        position: "0,130"
        render: "Label"
        size: "$screen_width-4,110"
        source: "desc"
        transparent: "1"
        zPosition: "2"
