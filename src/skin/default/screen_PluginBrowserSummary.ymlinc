screen:
  name: "PluginBrowserSummary"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - xmlinc:
        file: "screenpart_LCDTitle.ymlinc"
    - widget:
        font: "$F_medium"
        halign: "center"
        noWrap: "1"
        position: "0,65"
        render: "Label"
        size: "$width,65"
        source: "entry"
        zPosition: "2"
    - widget:
        font: "$F_small"
        halign: "center"
        position: "0,130"
        render: "Label"
        size: "$width,110"
        source: "desc"
        zPosition: "2"
